# LLM Provider: 'bedrock', 'openai', or 'ollama'
LLM_PROVIDER=bedrock

# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Available Bedrock Models:
# Claude 3 Haiku (fast & cheap): anthropic.claude-3-haiku-20240307-v1:0
# Claude 3 Sonnet (balanced): anthropic.claude-3-sonnet-20240229-v1:0
# Claude 3.5 Sonnet (best): anthropic.claude-3-5-sonnet-20241022-v2:0
# Llama 3 8B: meta.llama3-8b-instruct-v1:0
# Llama 3 70B: meta.llama3-70b-instruct-v1:0
# Mistral 7B: mistral.mistral-7b-instruct-v0:2
# Amazon Titan: amazon.titan-text-express-v1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# OpenAI Configuration (if using OpenAI instead)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Ollama Configuration (if using Ollama instead)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama2

# Debug Mode
DEBUG=false
